{
  "name": "sidewalk-walkd",
  "version": "1.0.2",
  "description": "sidewalk's local walk daemon: two append-only streams per walk, HTTP and SSE on 127.0.0.1:8760, started by sidewalk-mcp",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/kesensoy/sidewalk.git", "directory": "packages/walkd" },
  "homepage": "https://github.com/kesensoy/sidewalk#readme",
  "keywords": ["sidewalk", "walkthrough", "mcp", "agent", "qa"],
  "type": "module",
  "bin": { "walkd": "bin/walkd.js" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./schema": { "types": "./dist/schema/index.d.ts", "default": "./dist/schema/index.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "bin", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "scripts": { "build": "tsc -p tsconfig.json", "prepublishOnly": "npm run build" },
  "dependencies": { "zod": "^4.1.0" },
  "devDependencies": { "@types/node": "^22" }
}
