{
  "manifest_version": 3,
  "name": "sidewalk",
  "version": "1.0.2",
  "description": "Walk what your agent built, in a side panel.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "sidewalk", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "sw.js", "type": "module" },
  "permissions": ["sidePanel", "tabs", "activeTab", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "options_page": "panel.html"
}
