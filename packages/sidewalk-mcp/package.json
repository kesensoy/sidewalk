{
  "name": "sidewalk-mcp",
  "version": "1.0.2",
  "description": "The MCP server that lets an AI agent write a sidewalk walkthrough a person walks in a Chrome side panel; starts the walkd daemon if none is answering",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/kesensoy/sidewalk.git", "directory": "packages/sidewalk-mcp" },
  "homepage": "https://github.com/kesensoy/sidewalk#readme",
  "keywords": ["sidewalk", "walkthrough", "mcp", "mcp-server", "agent", "qa", "claude"],
  "type": "module",
  "bin": { "sidewalk-mcp": "bin/sidewalk-mcp.js" },
  "main": "dist/index.js",
  "files": ["dist", "bin", "README.md", "LICENSE"],
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "scripts": { "build": "tsc -p tsconfig.json", "prepublishOnly": "npm run build" },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.30.0", "sidewalk-walkd": "1.0.2", "zod": "^4.1.0" },
  "devDependencies": { "@types/node": "^22" }
